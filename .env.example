# Copy to .env.local for local dev. Add the same keys in Vercel → Project → Settings → Environment Variables.
# Everything is optional locally: missing keys switch that feature off instead of breaking the app.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
CONTACT_EMAIL=hello@surfaced.au
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_ABN=
NEXT_PUBLIC_GST_REGISTERED=   # set to true once registered for GST; the site then says prices include GST

# Operator console login (required in production)
ADMIN_PASSWORD=
SESSION_SECRET=            # any long random string
CRON_SECRET=               # any long random string; Vercel Cron sends it automatically

# AI engines (each one you add is checked in audits and weekly tracking)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Ollama Cloud: open model + Ollama web search. Needs usage credits on ollama.com.
OLLAMA_API_KEY=
OLLAMA_MODEL=deepseek-v4.1-flash

# Database (without these, data is stored in .data/surfaced.json)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Prospecting + rendering
GOOGLE_PLACES_API_KEY=
# Optional: a Google key allowed to call "PageSpeed Insights API" (free). Falls back to GOOGLE_PLACES_API_KEY.
PAGESPEED_API_KEY=
# Optional, pay per use: real ChatGPT / AI Overviews / Claude / Perplexity answers and Maps ranks.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Optional: which DataForSEO engines to run (default: chatgpt,ai_overview,perplexity,claude). DATAFORSEO_MAPS=off keeps Places for Maps.
DATAFORSEO_ENGINES=
FIRECRAWL_API_KEY=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FIXPACK=      # optional pre-created price IDs; otherwise prices are created inline
STRIPE_PRICE_TRACKING=
STRIPE_PRICE_VISIBILITY=
STRIPE_PRICE_GROWTH=

# Email
RESEND_API_KEY=
RESEND_FROM=Surfaced <onboarding@resend.dev>
# Public key for customer sign-in (Supabase Auth). Safe to expose; RLS protects the data.
SUPABASE_PUBLISHABLE_KEY=
