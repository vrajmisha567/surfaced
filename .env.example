# Copy to .env.local for local dev. Add the same keys in Vercel → Project → Settings → Environment Variables.
# Everything is optional locally: missing keys switch that feature off instead of breaking the app.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
CONTACT_EMAIL=hello@surfaced.au
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_ABN=

# Operator console login (required in production)
ADMIN_PASSWORD=
SESSION_SECRET=            # any long random string
CRON_SECRET=               # any long random string; Vercel Cron sends it automatically

# AI engines (each one you add is checked in audits and weekly tracking)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Database (without these, data is stored in .data/surfaced.json)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Prospecting + rendering
GOOGLE_PLACES_API_KEY=
FIRECRAWL_API_KEY=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FIXPACK=      # optional pre-created price IDs; otherwise prices are created inline
STRIPE_PRICE_VISIBILITY=
STRIPE_PRICE_GROWTH=

# Email
RESEND_API_KEY=
RESEND_FROM=Surfaced <onboarding@resend.dev>
